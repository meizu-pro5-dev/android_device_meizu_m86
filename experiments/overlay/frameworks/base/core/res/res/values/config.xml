<resources>
    <!-- Android 12 no longer discovers a legacy HIDL biometric solely from
         the registered 2.1 service. AuthService creates its provider from
         this ID:modality:strength entry. The Trustonic matcher and the stock
         Gatekeeper TA retain the hardware-auth-token chain, so expose the
         single FPC sensor as a strong fingerprint authenticator. -->
    <string-array name="config_biometric_sensors" translatable="false">
        <!-- ID0:Fingerprint:Strong -->
        <item>0:2:15</item>
    </string-array>
</resources>
