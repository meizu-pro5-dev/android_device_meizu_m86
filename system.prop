# Board
ro.product.board=m86
ro.board.platform=exynos5
ro.chipname=exynos7420

# Until the FPC navigation input is independently validated, expose Android's
# three-button navigation so the system remains operable after first boot.
qemu.hw.mainkeys=0

# Display
ro.opengles.version=196610
ro.sf.lcd_density=480

# Android 10 otherwise falls back to a 16 MiB application heap. Match the
# maintained Exynos 7420 profile used by the Note 5 generation so system_server
# and SystemUI can complete startup without continuous blocking collections.
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-filter=speed
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapstartsize=8m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# universal7420 uses the legacy Exynos OMX stack. Starting Android 10's CCodec
# service as well makes mediaswcodec repeatedly load C2 modules and the m86
# kernel stops responding during framework bring-up.
debug.stagefright.ccodec=0

# Meizu PRO 5 ES9018K2M HiFi DAC. The framework uses this capability flag to
# expose and restore the wired-media HiFi policy.
ro.meizu.hardware.hifi=true
ro.hardware.hifi.support=true

# Storage
persist.sys.isolated_storage=false
# Keep the device default outside /data/property so a stale value written by
# an earlier Android 10 build cannot re-enable isolated storage after a dirty
# flash. StorageManagerService copies this read-only default to the runtime
# persist property once DeviceConfig/local overrides have been considered.
ro.sys.isolated_storage=false

# Android 10's legacy FunctionFS transport otherwise submits Linux AIO to a
# 3.10 f_fs implementation which predates that support.  Keep the descriptor
# readiness handshake but use synchronous endpoint reads and writes.
sys.usb.ffs.aio_compat=1

# Wi-Fi
wifi.interface=wlan0
wifi.direct.interface=p2p-dev-wlan0

# NFC. These identify the final Flyme PN65T/PN547 I2C design; the open NXP
# Android 10 HAL takes the concrete device and firmware names from its config.
ro.nfc.platform=nxppn547
ro.nfc.port=I2C

# Radio. These values are taken from the final Flyme 8.0.5.0A system image.
# The Android 10 rild is 64-bit and loads the latest m86 SITRIL directly.
persist.radio.multisim.config=dsds
rild.libpath=/system/lib64/libsitril.so
rild.libargs=-d /dev/umts_ipc0
exynos.modempath=/system/vendor/firmware/modem.bin
ro.telephony.default_network=9
ro.ril.ecclist=911,08,112,118,999,000
radio.smsdomain=0
