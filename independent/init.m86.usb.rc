# Independent-vendor variant of usb/rootdir/etc/init.m86.usb.rc
on init
    write /sys/class/android_usb/android0/f_rndis/manufacturer Meizu
    write /sys/class/android_usb/android0/f_rndis/vendorID 2A45
    write /sys/class/android_usb/android0/f_rndis/wceis 1

# Mount FunctionFS before Android's generic legacy-gadget state machine starts
# adbd.  Aliasing "adb" to f_fs makes the Samsung android_usb driver defer its
# physical connect in ffs_function_enable(); writing descriptors to ep0 invokes
# functionfs_ready_callback(), which is the kernel-side readiness gate.
on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    mkdir /dev/bus 0755 root root
    mkdir /dev/bus/usb 0755 root root

on boot
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/f_mass_storage/inquiry_string "Meizu"
    write /sys/class/android_usb/android0/f_mass_storage/lun/nofua 1

service m86-usb-serial /vendor/bin/m86_usb_serial
    class core
    user root
    group root
    disabled
    oneshot

# /data is available here and ueventd has created the private-partition nodes.
# Publishing the factory serial is a USB identity event. Other subsystems may
# consume the published identity, but this action owns no foreign service.
on post-fs-data
    # Android 10 adbd otherwise selects the newer nonblocking/AIO FunctionFS
    # path, which this Samsung 3.10 gadget stack does not implement reliably.
    setprop persist.adb.nonblocking_ffs 0
    start m86-usb-serial

on property:vendor.m86.identity.ready=1
    # m86-usb-serial disconnects and rebinds the gadget to install the factory
    # serial.  Reopen FunctionFS afterwards so the new USB instance never
    # inherits requests or endpoint state from the pre-serial connection.
    stop adbd
    start adbd

on post-fs-data
    chown system system /sys/class/android_usb/android0/f_mass_storage/lun/file
    chmod 0660 /sys/class/android_usb/android0/f_mass_storage/lun/file
    chown system system /sys/class/android_usb/android0/f_rndis/ethaddr
    chmod 0660 /sys/class/android_usb/android0/f_rndis/ethaddr

on property:sys.usb.config=mtp && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 2A45
    write /sys/class/android_usb/android0/idProduct 2008
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 2A45
    write /sys/class/android_usb/android0/idProduct 0C02
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    stop adbd
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 2A45
    write /sys/class/android_usb/android0/idProduct 200B
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 2A45
    write /sys/class/android_usb/android0/idProduct 200C
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    stop adbd
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=rndis && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 04E8
    write /sys/class/android_usb/android0/idProduct 6863
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 224
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=rndis,adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 04E8
    write /sys/class/android_usb/android0/idProduct 6864
    write /sys/class/android_usb/android0/functions ${sys.usb.config}
    write /sys/class/android_usb/android0/bDeviceClass 224
    write /sys/class/android_usb/android0/enable 1
    stop adbd
    start adbd
    setprop sys.usb.state ${sys.usb.config}
