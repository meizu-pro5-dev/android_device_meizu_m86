+Return<void> RadioImpl::getPreferredNetworkTypeBitmap(int32_t serial) {
+    // Request-local callback routing avoids cross-slot / serial bookkeeping races.
+    static CommandInfo command = {RIL_REQUEST_GET_PREFERRED_NETWORK_TYPE, legacy14::bitmapResponse};
+    RequestInfo* ri = android::addRequestToList(serial, mSlotId, command.requestNumber);
+    if (ri) { ri->pCI = &command; CALL_ONREQUEST(command.requestNumber, nullptr, 0, ri, mSlotId); }
+    return Void();
+}
