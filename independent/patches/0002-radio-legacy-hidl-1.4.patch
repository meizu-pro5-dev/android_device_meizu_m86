+# Explicit test target, never installed in the product by default.
+include $(CLEAR_VARS)
+LOCAL_MODULE := m86-radio14-test
+LOCAL_VENDOR_MODULE := true
+LOCAL_MODULE_PATH := $(TARGET_OUT_DATA)/nativetest64/m86-radio14-test
+LOCAL_SRC_FILES := tests/radio14_test.cpp ril.cpp ril_event.cpp RilSapSocket.cpp sap_service.cpp
+LOCAL_C_INCLUDES := hardware/ril/include external/nanopb-c
+LOCAL_STATIC_LIBRARIES := libprotobuf-c-nano-enable_malloc-32bit
+LOCAL_SHARED_LIBRARIES := liblog libutils libcutils libhardware_legacy librilutils libhidlbase android.hardware.radio@1.0 android.hardware.radio@1.1 android.hardware.radio@1.2 android.hardware.radio@1.3 android.hardware.radio@1.4
