+namespace legacy14 {
+static const char* protocol(V1_4::PdpProtocolType p) {
+    switch (p) {
+        case V1_4::PdpProtocolType::IP: return "IP";
+        case V1_4::PdpProtocolType::IPV6: return "IPV6";
+        case V1_4::PdpProtocolType::IPV4V6: return "IPV4V6";
+        case V1_4::PdpProtocolType::PPP: return "PPP";
+        default: return "";
+    }
+}
+static DataProfileInfo profile(const V1_4::DataProfileInfo& p) {
+    DataProfileInfo q = {};
+    q.profileId = p.profileId; q.apn = p.apn;
+    q.protocol = protocol(p.protocol); q.roamingProtocol = protocol(p.roamingProtocol);
+    q.authType = p.authType; q.user = p.user; q.password = p.password;
+    q.type = p.type; q.maxConnsTime = p.maxConnsTime; q.maxConns = p.maxConns;
+    q.waitTime = p.waitTime; q.enabled = p.enabled;
+    q.supportedApnTypesBitmap = p.supportedApnTypesBitmap;
+    q.bearerBitmap = p.bearerBitmap; q.mtu = p.mtu; q.mvnoType = MvnoType::NONE;
+    return q;
+}
+static RadioTechnology rat(int access) {
+    switch (access) {
+        case 1: return RadioTechnology::GPRS;
+        case 2: return RadioTechnology::UMTS;
+        case 3: return RadioTechnology::LTE;
+        case 4: return RadioTechnology::IS95A;
+        default: return RadioTechnology::UNKNOWN;
+    }
+}
+static hidl_vec<hidl_string> words(const hidl_string& s) {
+    std::istringstream in(s.c_str()); std::vector<hidl_string> parts;
+    for (std::string word; in >> word;) parts.emplace_back(word);
+    return parts;
+}
+static V1_4::SetupDataCallResult data(const SetupDataCallResult& p) {
+    V1_4::SetupDataCallResult q = {};
+    q.cause = static_cast<V1_4::DataCallFailCause>(p.status);
+    q.suggestedRetryTime = p.suggestedRetryTime; q.cid = p.cid;
+    q.active = static_cast<V1_4::DataConnActiveStatus>(p.active);
+    q.type = V1_4::PdpProtocolType::UNKNOWN;
+    for (auto type : {V1_4::PdpProtocolType::IP, V1_4::PdpProtocolType::IPV6,
+                     V1_4::PdpProtocolType::IPV4V6, V1_4::PdpProtocolType::PPP}) {
+        if (p.type == protocol(type)) q.type = type;
+    }
+    q.ifname = p.ifname; q.addresses = words(p.addresses); q.dnses = words(p.dnses);
+    q.gateways = words(p.gateways); q.pcscf = words(p.pcscf); q.mtu = p.mtu;
+    return q;
+}
+static hidl_vec<V1_4::SetupDataCallResult> data(const hidl_vec<SetupDataCallResult>& p) {
+    hidl_vec<V1_4::SetupDataCallResult> q; q.resize(p.size());
+    for (size_t i = 0; i < p.size(); ++i) q[i] = data(p[i]);
+    return q;
+}
+static V1_2::SignalStrength signal12(const SignalStrength& p) {
+    V1_2::SignalStrength q = {};
+    q.gsm = p.gw; q.cdma = p.cdma; q.evdo = p.evdo; q.lte = p.lte;
+    q.tdScdma = p.tdScdma;
+    q.wcdma = {{INT_MAX, INT_MAX}, INT_MAX, INT_MAX};
+    return q;
+}
+static V1_4::SignalStrength signal14(const SignalStrength& p) {
+    auto s = signal12(p); V1_4::SignalStrength q = {};
+    q.gsm = s.gsm; q.cdma = s.cdma; q.evdo = s.evdo; q.lte = s.lte;
+    q.wcdma = s.wcdma;
+    // The legacy TD-SCDMA RSCP is positive dBm; 1.4 uses TS 27.007 encoding.
+    q.tdscdma = {INT_MAX, INT_MAX, INT_MAX};
+    if (p.tdScdma.rscp >= 25 && p.tdScdma.rscp <= 120)
+        q.tdscdma.rscp = 120 - p.tdScdma.rscp;
+    q.nr = {INT_MAX, INT_MAX, INT_MAX, INT_MAX, INT_MAX, INT_MAX};
+    return q;
+}
+static V1_2::CardStatus card12(const CardStatus& p, int slot) {
+    V1_2::CardStatus q = {}; q.base = p; q.physicalSlotId = slot; return q;
+}
+static V1_4::CardStatus card14(const CardStatus& p, int slot) {
+    V1_4::CardStatus q = {}; q.base = card12(p, slot); return q;
+}
+static hidl_vec<V1_2::Call> calls12(const hidl_vec<Call>& p) {
+    hidl_vec<V1_2::Call> q; q.resize(p.size());
+    for (size_t i = 0; i < p.size(); ++i) {
+        q[i].base = p[i]; q[i].audioQuality = V1_2::AudioQuality::UNSPECIFIED;
+    }
+    return q;
+}
+static V1_2::CellIdentity identity12(const CellIdentity& p) {
+    V1_2::CellIdentity q = {}; q.cellInfoType = p.cellInfoType;
+    q.cellIdentityGsm.resize(p.cellIdentityGsm.size());
+    for (size_t i = 0; i < p.cellIdentityGsm.size(); ++i) {
+        q.cellIdentityGsm[i].base = p.cellIdentityGsm[i];
+    }
+    q.cellIdentityWcdma.resize(p.cellIdentityWcdma.size());
+    for (size_t i = 0; i < p.cellIdentityWcdma.size(); ++i) {
+        q.cellIdentityWcdma[i].base = p.cellIdentityWcdma[i];
+    }
+    q.cellIdentityCdma.resize(p.cellIdentityCdma.size());
+    for (size_t i = 0; i < p.cellIdentityCdma.size(); ++i) {
+        q.cellIdentityCdma[i].base = p.cellIdentityCdma[i];
+    }
+    q.cellIdentityLte.resize(p.cellIdentityLte.size());
+    for (size_t i = 0; i < p.cellIdentityLte.size(); ++i) {
+        q.cellIdentityLte[i].base = p.cellIdentityLte[i];
+        q.cellIdentityLte[i].bandwidth = INT_MAX;
+    }
+    q.cellIdentityTdscdma.resize(p.cellIdentityTdscdma.size());
+    for (size_t i = 0; i < p.cellIdentityTdscdma.size(); ++i) {
+        q.cellIdentityTdscdma[i].base = p.cellIdentityTdscdma[i];
+        q.cellIdentityTdscdma[i].uarfcn = INT_MAX;
+    }
+    return q;
+}
+static V1_2::VoiceRegStateResult voice12(const VoiceRegStateResult& p) {
+    V1_2::VoiceRegStateResult q = {};
+    q.regState = p.regState;
+    q.rat = p.rat;
+    q.cssSupported = p.cssSupported;
+    q.roamingIndicator = p.roamingIndicator;
+    q.systemIsInPrl = p.systemIsInPrl;
+    q.defaultRoamingIndicator = p.defaultRoamingIndicator;
+    q.reasonForDenial = p.reasonForDenial;
+    q.cellIdentity = identity12(p.cellIdentity); return q;
+}
+static V1_2::DataRegStateResult data12(const DataRegStateResult& p) {
+    V1_2::DataRegStateResult q = {};
+    q.regState = p.regState;
+    q.rat = p.rat;
+    q.reasonDataDenied = p.reasonDataDenied;
+    q.maxDataCalls = p.maxDataCalls;
+    q.cellIdentity = identity12(p.cellIdentity); return q;
+}
+static V1_4::DataRegStateResult data14(const DataRegStateResult& p) {
+    V1_4::DataRegStateResult q = {}; q.base = data12(p);
+    // Old SITRIL supplies neither LTE VOPS nor NR capabilities. Leave unknown.
+    return q;
+}
+static hidl_vec<V1_2::CellInfo> cells12(const hidl_vec<CellInfo>& p) {
+    hidl_vec<V1_2::CellInfo> q; q.resize(p.size());
+    for (size_t i = 0; i < p.size(); ++i) {
+        const auto& a = p[i]; auto& b = q[i];
+        b.cellInfoType = a.cellInfoType; b.registered = a.registered;
+        b.timeStampType = a.timeStampType; b.timeStamp = a.timeStamp;
+        b.connectionStatus = a.registered ? V1_2::CellConnectionStatus::PRIMARY_SERVING : V1_2::CellConnectionStatus::NONE;
+        b.gsm.resize(a.gsm.size());
+        for (size_t j = 0; j < a.gsm.size(); ++j) {
+            b.gsm[j].cellIdentityGsm.base = a.gsm[j].cellIdentityGsm;
+            b.gsm[j].signalStrengthGsm = a.gsm[j].signalStrengthGsm;
+        }
+        b.wcdma.resize(a.wcdma.size());
+        for (size_t j = 0; j < a.wcdma.size(); ++j) {
+            b.wcdma[j].cellIdentityWcdma.base = a.wcdma[j].cellIdentityWcdma;
+            b.wcdma[j].signalStrengthWcdma = {a.wcdma[j].signalStrengthWcdma, INT_MAX, INT_MAX};
+        }
+        b.cdma.resize(a.cdma.size());
+        for (size_t j = 0; j < a.cdma.size(); ++j) {
+            b.cdma[j].cellIdentityCdma.base = a.cdma[j].cellIdentityCdma;
+            b.cdma[j].signalStrengthCdma = a.cdma[j].signalStrengthCdma;
+            b.cdma[j].signalStrengthEvdo = a.cdma[j].signalStrengthEvdo;
+        }
+        b.lte.resize(a.lte.size());
+        for (size_t j = 0; j < a.lte.size(); ++j) {
+            b.lte[j].cellIdentityLte.base = a.lte[j].cellIdentityLte;
+            b.lte[j].cellIdentityLte.bandwidth = INT_MAX;
+            b.lte[j].signalStrengthLte = a.lte[j].signalStrengthLte;
+        }
+        b.tdscdma.resize(a.tdscdma.size());
+        for (size_t j = 0; j < a.tdscdma.size(); ++j) {
+            b.tdscdma[j].cellIdentityTdscdma.base = a.tdscdma[j].cellIdentityTdscdma;
+            b.tdscdma[j].cellIdentityTdscdma.uarfcn = INT_MAX;
+            b.tdscdma[j].signalStrengthTdscdma = {INT_MAX, INT_MAX, INT_MAX};
+            auto rscp = a.tdscdma[j].signalStrengthTdscdma.rscp;
+            if (rscp >= 25 && rscp <= 120) b.tdscdma[j].signalStrengthTdscdma.rscp = 120 - rscp;
+        }
+    }
+    return q;
+}
+static hidl_vec<V1_4::CellInfo> cells14(const hidl_vec<CellInfo>& p) {
+    auto old = cells12(p); std::vector<V1_4::CellInfo> out;
+    for (const auto& a : old) {
+        V1_4::CellInfo b = {}; b.isRegistered = a.registered;
+        b.connectionStatus = a.connectionStatus;
+        switch (a.cellInfoType) {
+            case CellInfoType::GSM:
+                if (a.gsm.size() != 1) continue;
+                b.info.gsm(a.gsm[0]); break;
+            case CellInfoType::WCDMA:
+                if (a.wcdma.size() != 1) continue;
+                b.info.wcdma(a.wcdma[0]); break;
+            case CellInfoType::CDMA:
+                if (a.cdma.size() != 1) continue;
+                b.info.cdma(a.cdma[0]); break;
+            case CellInfoType::LTE:
+                if (a.lte.size() != 1) continue;
+                b.info.lte({a.lte[0], {false}}); break;
+            case CellInfoType::TD_SCDMA:
+                if (a.tdscdma.size() != 1) continue;
+                b.info.tdscdma(a.tdscdma[0]); break;
+            default: continue; // No safe-union discriminator for an unknown legacy cell.
+        }
+        out.push_back(b);
+    }
+    return out;
+}
+static constexpr uint32_t bit(RadioAccessFamily f) { return static_cast<uint32_t>(f); }
+static constexpr uint32_t gsm = bit(RadioAccessFamily::GSM) | bit(RadioAccessFamily::GPRS) | bit(RadioAccessFamily::EDGE);
+static constexpr uint32_t wcdma = bit(RadioAccessFamily::UMTS) | bit(RadioAccessFamily::HSDPA) | bit(RadioAccessFamily::HSUPA) | bit(RadioAccessFamily::HSPA) | bit(RadioAccessFamily::HSPAP);
+static constexpr uint32_t cdma = bit(RadioAccessFamily::IS95A) | bit(RadioAccessFamily::IS95B) | bit(RadioAccessFamily::ONE_X_RTT);
+static constexpr uint32_t evdo = bit(RadioAccessFamily::EVDO_0) | bit(RadioAccessFamily::EVDO_A) | bit(RadioAccessFamily::EVDO_B) | bit(RadioAccessFamily::EHRPD);
+static constexpr uint32_t lte = bit(RadioAccessFamily::LTE) | bit(RadioAccessFamily::LTE_CA);
+static constexpr uint32_t td = bit(RadioAccessFamily::TD_SCDMA);
+static constexpr uint32_t modes[] = {
+    gsm|wcdma, gsm, wcdma, gsm|wcdma, cdma|evdo, cdma, evdo,
+    gsm|wcdma|cdma|evdo, lte|cdma|evdo, lte|gsm|wcdma, lte|gsm|wcdma|cdma|evdo,
+    lte, lte|wcdma, td, td|wcdma, lte|td, td|gsm, lte|td|gsm,
+    td|gsm|wcdma, lte|td|wcdma, lte|td|gsm|wcdma,
+    td|cdma|evdo|gsm|wcdma, lte|td|cdma|evdo|gsm|wcdma
+};
+static int networkMode(uint32_t mask) {
+    for (uint32_t group : {gsm, wcdma, cdma, evdo, lte})
+        if (mask & group) mask |= group;
+    for (size_t i = 0; i < sizeof(modes)/sizeof(modes[0]); ++i)
+        if (mask == modes[i]) return i;
+    return -1; // Do not silently turn an unrepresentable bitmap into a wider mode.
+}
+static int bitmapResponse(int slotId, int responseType, int serial, RIL_Errno e,
+                          void* response, size_t responseLen) {
+    auto service = radioService[slotId];
+    if (!service->mRadioResponseV1_4) return 0;
+    RadioResponseInfo info = {};
+    int mode = responseInt(info, serial, responseType, e, response, responseLen);
+    uint32_t mask = 0;
+    if (info.error == RadioError::NONE) {
+        if (mode < 0 || size_t(mode) >= sizeof(modes)/sizeof(modes[0]))
+            info.error = RadioError::INVALID_RESPONSE;
+        else mask = modes[mode];
+    }
+    auto ret = service->mRadioResponseV1_4->getPreferredNetworkTypeBitmapResponse(info, mask);
+    service->checkReturnStatus(ret); return 0;
+}
+static int setBitmapResponse(int slotId, int responseType, int serial, RIL_Errno e,
+                             void*, size_t) {
+    auto service = radioService[slotId];
+    if (!service->mRadioResponseV1_4) return 0;
+    RadioResponseInfo info = {}; populateResponseInfo(info, serial, responseType, e);
+    auto ret = service->mRadioResponseV1_4->setPreferredNetworkTypeBitmapResponse(info);
+    service->checkReturnStatus(ret); return 0;
+}
