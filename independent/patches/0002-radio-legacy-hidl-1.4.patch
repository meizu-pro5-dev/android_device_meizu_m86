+// Copyright 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+// Exercise the actual bridge with a fake vendor function table. Never connects to rild.
+#include "../ril_service.cpp"
+#include "radio14_mocks.h"
+#include <cstdio>
+#include <cstdlib>
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); } ++checks; } while (0)
+static int checks = 0;
+static int requests = 0;
+static int lastRequest = -1;
+static int lastSlot = -1;
+static int lastMode = -1;
+static std::vector<std::string> requestStrings;
+static RIL_Token pending;
+static void mockRequest(int request, void* data, size_t len, RIL_Token token, RIL_SOCKET_ID slot) {
+    ++requests; lastRequest = request; lastSlot = slot; pending = token;
+    if (request == RIL_REQUEST_SET_PREFERRED_NETWORK_TYPE) {
+        CHECK(len == sizeof(int)); lastMode = *static_cast<int*>(data);
+    }
+    if (request == RIL_REQUEST_SETUP_DATA_CALL) {
+        CHECK(len == 7 * sizeof(char*)); requestStrings.clear();
+        auto strings = static_cast<char**>(data);
+        for (int i = 0; i < 7; ++i) requestStrings.emplace_back(strings[i] ? strings[i] : "");
+    }
+    // Complete only when the test says so, to exercise out-of-order slot responses.
+}
+static void complete(RIL_Errno error = RIL_E_SUCCESS, void* data = nullptr, size_t len = 0) {
+    RIL_onRequestComplete(pending, error, data, len); pending = nullptr;
+}
+template<class F> static void response(int slot, F fn) {
+    auto* lock = radio::getRadioServiceRwlock(slot);
+    pthread_rwlock_rdlock(lock); fn(); pthread_rwlock_unlock(lock);
+}
+int main() {
+    RIL_RadioFunctions vendor = {}; vendor.version = 12; vendor.onRequest = mockRequest;
+    s_vendorFunctions = &vendor;
+    sp<MockIRadioResponse> callbacks[2]; sp<MockIRadioIndication> indications[2];
+    for (int slot = 0; slot < 2; ++slot) {
+        radioService[slot] = new RadioImpl; auto service = radioService[slot]; service->mSlotId = slot;
+        callbacks[slot] = new MockIRadioResponse; indications[slot] = new MockIRadioIndication;
+        service->mRadioResponse = callbacks[slot]; service->mRadioIndication = indications[slot];
+        service->mRadioResponseV1_1 = callbacks[slot]; service->mRadioIndicationV1_1 = indications[slot];
+        service->mRadioResponseV1_2 = callbacks[slot]; service->mRadioIndicationV1_2 = indications[slot];
+        service->mRadioResponseV1_3 = callbacks[slot]; service->mRadioIndicationV1_3 = indications[slot];
+        service->mRadioResponseV1_4 = callbacks[slot]; service->mRadioIndicationV1_4 = indications[slot];
+        RIL_CardStatus_v6 card = {}; card.card_state = RIL_CARDSTATE_ABSENT;
+        card.gsm_umts_subscription_app_index = card.cdma_subscription_app_index = card.ims_subscription_app_index = -1;
+        response(slot, [&] { radio::getIccCardStatusResponse(slot, RESPONSE_SOLICITED, 10, RIL_E_SUCCESS, &card, sizeof(card)); });
+        CHECK(callbacks[slot]->last == "getIccCardStatusResponse_1_4");
+        CHECK(callbacks[slot]->card.base.physicalSlotId == uint32_t(slot));
+        CHECK(callbacks[slot]->lastInfo.error == RadioError::NONE);
+        card.num_applications = -1;
+        response(slot, [&] { radio::getIccCardStatusResponse(slot, RESPONSE_SOLICITED, 11, RIL_E_SUCCESS, &card, sizeof(card)); });
+        CHECK(callbacks[slot]->lastInfo.error == RadioError::INVALID_RESPONSE);
+        card.num_applications = RIL_CARD_MAX_APPS + 1;
+        response(slot, [&] { radio::getIccCardStatusResponse(slot, RESPONSE_SOLICITED, 12, RIL_E_SUCCESS, &card, sizeof(card)); });
+        CHECK(callbacks[slot]->lastInfo.error == RadioError::INVALID_RESPONSE);
+    }
+    for (size_t i = 0; i < sizeof(legacy14::modes)/sizeof(legacy14::modes[0]); ++i) {
+        int mode = legacy14::networkMode(legacy14::modes[i]);
+        CHECK(mode >= 0); CHECK(legacy14::modes[mode] == legacy14::modes[i]);
+    }
+    CHECK(legacy14::networkMode(0) == -1); CHECK(legacy14::networkMode(1u << 30) == -1);
+    auto service = radioService[0]; auto cb = callbacks[0];
+    service->getPreferredNetworkTypeBitmap(20); RIL_Token slot0 = pending;
+    radioService[1]->getPreferredNetworkTypeBitmap(20); RIL_Token slot1 = pending;
+    CHECK(slot0 != slot1); int mode = 9;
+    pending = slot1; complete(RIL_E_SUCCESS, &mode, sizeof(mode));
+    CHECK(callbacks[1]->last == "getPreferredNetworkTypeBitmapResponse");
+    pending = slot0; complete(RIL_E_SUCCESS, &mode, sizeof(mode));
+    CHECK(cb->last == "getPreferredNetworkTypeBitmapResponse");
+    service->setPreferredNetworkTypeBitmap(21, legacy14::lte | legacy14::gsm | legacy14::wcdma);
+    CHECK(lastMode == 9); CHECK(lastSlot == 0); complete();
+    CHECK(cb->last == "setPreferredNetworkTypeBitmapResponse");
+    service->getPreferredNetworkType(22); complete(RIL_E_SUCCESS, &mode, sizeof(mode));
+    CHECK(cb->last == "getPreferredNetworkTypeResponse");
+    int before = requests;
+    service->setPreferredNetworkTypeBitmap(23, 1u << 30);
+    CHECK(requests == before); CHECK(cb->lastInfo.error == RadioError::INVALID_ARGUMENTS);
+    V1_4::DataProfileInfo profile = {}; profile.apn = "test.invalid";
+    profile.protocol = V1_4::PdpProtocolType::IPV4V6; profile.roamingProtocol = V1_4::PdpProtocolType::IP;
+    profile.profileId = DataProfileId::DEFAULT;
+    service->setupDataCall_1_4(24, V1_4::AccessNetwork::EUTRAN, profile, true,
+                             V1_2::DataRequestReason::NORMAL, {}, {});
+    CHECK(lastRequest == RIL_REQUEST_SETUP_DATA_CALL); CHECK(requestStrings[0] == "16");
+    CHECK(requestStrings[2] == "test.invalid"); CHECK(requestStrings[6] == "IPV4V6");
+    complete(RIL_E_RADIO_NOT_AVAILABLE); CHECK(cb->last == "setupDataCallResponse_1_4");
+    service->mDataRoaming = true;
+    service->setupDataCall_1_4(25, V1_4::AccessNetwork::EUTRAN, profile, true,
+                             V1_2::DataRequestReason::NORMAL, {}, {});
+    CHECK(requestStrings[6] == "IP"); complete(RIL_E_RADIO_NOT_AVAILABLE);
+    before = requests;
+    service->setupDataCall_1_4(26, V1_4::AccessNetwork::IWLAN, profile, true,
+                             V1_2::DataRequestReason::HANDOVER, {}, {});
+    CHECK(requests == before); CHECK(cb->lastInfo.error == RadioError::REQUEST_NOT_SUPPORTED);
+    SetupDataCallResult oldData = {}; oldData.type = "IPV4V6";
+    oldData.addresses = "192.0.2.1/32  2001:db8::1/64"; oldData.dnses = "192.0.2.53";
+    oldData.gateways = ""; oldData.pcscf = "2001:db8::5"; oldData.cid = 7; oldData.mtu = 1500;
+    auto newData = legacy14::data(oldData);
+    CHECK(newData.addresses.size() == 2); CHECK(newData.gateways.size() == 0);
+    CHECK(newData.type == V1_4::PdpProtocolType::IPV4V6); CHECK(newData.mtu == 1500);
+    SignalStrength oldSignal = {}; oldSignal.tdScdma.rscp = 80; oldSignal.lte.rsrp = 95;
+    auto newSignal = legacy14::signal14(oldSignal);
+    CHECK(newSignal.lte.rsrp == 95); CHECK(newSignal.tdscdma.rscp == 40);
+    CHECK(newSignal.nr.ssRsrp == INT_MAX); CHECK(newSignal.wcdma.rscp == INT_MAX);
+    response(0, [&] { radio::setupDataCallResponse(0, RESPONSE_SOLICITED, 27, RIL_E_SUCCESS, &mode, 0); });
+    CHECK(cb->lastInfo.error == RadioError::INVALID_RESPONSE);
+    int32_t vendorSignal[15] = {15, 2, 0, 0, 0x22222222, 0, 0, 0x33333333,
+                                20, 95, 10, 50, 8, 4, 80};
+    SignalStrength decoded = {};
+    CHECK(validSignalStrengthSize(sizeof(vendorSignal)));
+    CHECK(!validSignalStrengthSize(59)); CHECK(!validSignalStrengthSize(61));
+    convertRilSignalStrengthToHal(vendorSignal, sizeof(vendorSignal), decoded);
+    CHECK(decoded.gw.signalStrength == 15); CHECK(decoded.lte.signalStrength == 20);
+    CHECK(decoded.lte.rsrp == 95); CHECK(decoded.lte.rsrq == 10);
+    CHECK(decoded.lte.rssnr == 50); CHECK(decoded.lte.cqi == 8);
+    CHECK(decoded.lte.timingAdvance == 4); CHECK(decoded.tdScdma.rscp == 80);
+    CHECK(decoded.cdma.dbm == INT_MAX); CHECK(decoded.evdo.dbm == INT_MAX);
+    response(0, [&] { radio::getSignalStrengthResponse(0, RESPONSE_SOLICITED, 29, RIL_E_SUCCESS, vendorSignal, sizeof(vendorSignal)); });
+    CHECK(cb->last == "getSignalStrengthResponse_1_4"); CHECK(cb->lastInfo.error == RadioError::NONE);
+    response(0, [&] { radio::currentSignalStrengthInd(0, 0, 0, RIL_E_SUCCESS, vendorSignal, sizeof(vendorSignal)); });
+    CHECK(indications[0]->last == "currentSignalStrength_1_4");
+    vendorSignal[9] = INT_MIN; vendorSignal[10] = -1;
+    convertRilSignalStrengthToHal(vendorSignal, sizeof(vendorSignal), decoded);
+    CHECK(decoded.lte.rsrp == INT_MAX); CHECK(decoded.lte.rsrq == INT_MAX);
+    CHECK(vendorSignal[9] == INT_MIN); CHECK(vendorSignal[4] == 0x22222222);
+    vendor.version = 15; CHECK(!validSignalStrengthSize(sizeof(vendorSignal))); vendor.version = 12;
+    service->mRadioResponseV1_4 = nullptr; service->mRadioResponseV1_3 = nullptr; service->mRadioResponseV1_2 = nullptr;
+    RIL_SignalStrength_v10 strength = {};
+    response(0, [&] { radio::getSignalStrengthResponse(0, RESPONSE_SOLICITED, 28, RIL_E_SUCCESS, &strength, sizeof(strength)); });
+    CHECK(cb->last == "getSignalStrengthResponse");
+    printf("PASS: %d checks; no real modem or binder service used\n", checks);
+    fflush(stdout);
+    return 0;
+}
