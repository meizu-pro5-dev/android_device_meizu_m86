+Return<void> RadioImpl::setIndicationFilter_1_2(int32_t serial,
+            hidl_bitfield<::android::hardware::radio::V1_2::IndicationFilter> indicationFilter) {
+    // Preserve the original bit positions; new physical-channel filtering is unsupported.
+    if (indicationFilter & ~uint32_t(7)) {
+        return reply(serial, RadioError::REQUEST_NOT_SUPPORTED, [&](const RadioResponseInfo& info) {
+        if (mRadioResponseV1_2) {
+            auto ret = mRadioResponseV1_2->setIndicationFilterResponse(info); checkReturnStatus(ret);
+        }
+    });
+    }
+    return setIndicationFilter(serial, static_cast<int32_t>(indicationFilter));
+}
