+    static CommandInfo command = {RIL_REQUEST_SET_PREFERRED_NETWORK_TYPE, legacy14::setBitmapResponse};
+    RequestInfo* ri = android::addRequestToList(serial, mSlotId, command.requestNumber);
+    if (ri) { ri->pCI = &command; CALL_ONREQUEST(command.requestNumber, &mode, sizeof(mode), ri, mSlotId); }
+    return Void();
+}
