+Return<void> RadioImpl::emergencyDial(int32_t serial,
+            const ::android::hardware::radio::V1_0::Dial& dialInfo,
+            hidl_bitfield<android::hardware::radio::V1_4::EmergencyServiceCategory> categories,
+            const hidl_vec<hidl_string>& urns,
+            ::android::hardware::radio::V1_4::EmergencyCallRouting routing,
+            bool fromEmergencyDialer, bool isTesting) {
+    // SITRIL CCscService::DoDial classifies numbers through its emergency-number
+    // tables. Preserve that pre-1.4 dialing path and use the new response callback.
+    // The old ABI cannot express test-only calls or category/URN overrides.
+    if (isTesting || urns.size() != 0) {
+        return reply(serial, RadioError::INVALID_ARGUMENTS, [&](const RadioResponseInfo& info) {
+            if (mRadioResponseV1_4) {
+                auto ret = mRadioResponseV1_4->emergencyDialResponse(info); checkReturnStatus(ret);
+            }
+        });
+    }
+    static CommandInfo command = {RIL_REQUEST_DIAL,
+        [](int slot, int type, int token, RIL_Errno error, void*, size_t) -> int {
+            auto service = radioService[slot];
+            if (service->mRadioResponseV1_4) {
+                RadioResponseInfo info = {}; populateResponseInfo(info, token, type, error);
+                auto ret = service->mRadioResponseV1_4->emergencyDialResponse(info);
+                service->checkReturnStatus(ret);
+            }
+            return 0;
+        }};
+    return dialLegacy(serial, dialInfo, &command);
+}
