cc_binary {
    name: "m86_gatekeeper_service",
    stem: "android.hardware.gatekeeper@1.0-service.m86",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.gatekeeper@1.0-service.m86.rc"],

    srcs: ["service.cpp"],

    shared_libs: [
        "android.hardware.gatekeeper@1.0",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
