import /init.m86.usb.rc
import /init.m86.sensors.rc
import /init.m86.wifi.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug mode=755

on fs
    mount_all /fstab.m86
    mkdir /cache/m86-lineage-debug 0775 root log
    write /cache/m86-lineage-boot-stage fs-mounted

on post-fs
    write /cache/m86-lineage-boot-stage post-fs

on post-fs-data
    write /cache/m86-lineage-boot-stage post-fs-data
    # Keep early userspace, framework and kernel log buffers across a failed
    # boot. Android's supported logcatd service writes under /data/misc/logd
    # with the correct SELinux domain and rotates at four 1 MiB files.
    setprop logd.logpersistd.buffer all
    setprop logd.logpersistd.size 4
    setprop logd.logpersistd logcatd
    setprop logd.logpersistd.enable true
    start m86_boot_sync
    mkdir /data/system/gps 0770 system system
    setprop vold.post_fs_data_done 1

on boot
    write /cache/m86-lineage-boot-stage boot
    chown gps system /dev/ttySAC1
    chmod 0600 /dev/ttySAC1
    # bcmdhd is built into the kernel, so its module parameter exists after
    # ueventd's one-shot sysfs pass.  Give the Wi-Fi HAL the DAC owner before
    # it receives the lazy HIDL start request.
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    chown system system /sys/class/misc/gps/device/pwr
    chmod 0770 /sys/class/misc/gps/device/pwr
    chown system system /sys/devices/13930000.decon_fb/adreg
    chmod 0660 /sys/devices/13930000.decon_fb/adreg
    chown system system /sys/class/backlight/pwm-backlight.0/brightness
    chmod 0660 /sys/class/backlight/pwm-backlight.0/brightness
    chown system system /sys/class/leds/m86_led/brightness
    chmod 0660 /sys/class/leds/m86_led/brightness
    chown cameraserver camera /sys/class/leds/torch0/brightness
    chmod 0660 /sys/class/leds/torch0/brightness
    chown cameraserver camera /sys/class/leds/torch0/hwen
    chmod 0660 /sys/class/leds/torch0/hwen
    chown cameraserver camera /sys/class/leds/torch0/onoff
    chmod 0660 /sys/class/leds/torch0/onoff
    chown cameraserver camera /sys/class/leds/torch0/enable
    chmod 0660 /sys/class/leds/torch0/enable
    chown cameraserver camera /sys/class/leds/torch1/brightness
    chmod 0660 /sys/class/leds/torch1/brightness
    chown cameraserver camera /sys/class/leds/torch1/onoff
    chmod 0660 /sys/class/leds/torch1/onoff
    chown cameraserver camera /sys/class/leds/torch1/enable
    chmod 0660 /sys/class/leds/torch1/enable
    chown system system /sys/class/timed_output/vibrator/enable
    chmod 0660 /sys/class/timed_output/vibrator/enable
    chown system system /sys/bus/spi/devices/spi4.0/irq
    # Flyme's HAL ran as root, so the stock 0440 was only readable for
    # system; the LineageOS HAL runs as system and acks the node by writing
    # it, so it needs group write like the other FPC sysfs files.
    chmod 0660 /sys/bus/spi/devices/spi4.0/irq
    chown system system /sys/bus/spi/devices/spi4.0/wakeup_enable
    chmod 0660 /sys/bus/spi/devices/spi4.0/wakeup_enable
    chown system system /sys/bus/spi/devices/spi4.0/clk_enable
    chmod 0660 /sys/bus/spi/devices/spi4.0/clk_enable
    chown system system /sys/bus/spi/devices/spi4.0/lock_freq
    chmod 0660 /sys/bus/spi/devices/spi4.0/lock_freq
    chown system system /sys/bus/spi/devices/spi4.0/hw_reset
    chmod 0660 /sys/bus/spi/devices/spi4.0/hw_reset
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/interactive/boostpulse
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/interactive/boostpulse
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/interactive/boostpulse_duration
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/interactive/boostpulse_duration
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/interactive/boostpulse
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/interactive/boostpulse
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/interactive/boostpulse_duration
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/interactive/boostpulse_duration
    chown system system /sys/module/exynos_march_cpu_hotplug/parameters/current_profile_no
    chmod 0660 /sys/module/exynos_march_cpu_hotplug/parameters/current_profile_no
    chown system system /sys/module/exynos_march_cpu_hotplug/parameters/cl1_booster
    chmod 0660 /sys/module/exynos_march_cpu_hotplug/parameters/cl1_booster
    chown system system /sys/module/exynos_march_cpu_hotplug/parameters/min_cpu_boosted
    chmod 0660 /sys/module/exynos_march_cpu_hotplug/parameters/min_cpu_boosted

on property:sys.boot_completed=1
    write /cache/m86-lineage-boot-stage boot-completed

# pstore is disabled in the current kernel. logpersistd retains all Android
# buffers (including kernel) under /data/misc/logd with its native SELinux
# label. This low-volume init-domain heartbeat periodically flushes those logs
# without feeding cache-write AVCs back into the buffers being recorded.
service m86_boot_sync /system/bin/sh /init.m86.boot-sync.sh
    class core
    user root
    group root log system
    disabled
    seclabel u:r:init:s0

# The final Flyme 8 ramdisk starts this exact cbd build with the production
# user-mode selector. It boots only the verified m86 modem.bin and persistent
# /efs NV data; no Galaxy modemloader or radio partition is used.
service cpboot-daemon /system/bin/cbd -m user
    class main
    user root
    group system radio cache inet misc audio log

# Broadcom GNSS daemon and socket ABI from the final Flyme 8 ramdisk. The
# legacy gps.default HAL connects to /dev/socket/gps through the HIDL wrapper.
service gpsd /system/bin/gpsd /system/etc/gps.xml
    class main
    socket gps seqpacket 0660 gps system
    socket rilgps.socket seqpacket 0660 gps system
    user gps
    group system inet sdcard_rw wakelock
