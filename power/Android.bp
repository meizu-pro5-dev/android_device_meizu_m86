cc_binary {
    name: "android.hardware.power-service.m86",
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.m86.rc"],
    vintf_fragments: ["android.hardware.power-service.m86.xml"],
    vendor: true,
    srcs: [
        "Power.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.power-V2-ndk",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
