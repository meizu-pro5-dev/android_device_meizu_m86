cc_binary {
    name: "android.hardware.audio.service.m86",

    init_rc: ["android.hardware.audio.service.m86.rc"],
    relative_install_path: "hw",
    vendor: true,

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libbinder",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],

    defaults: ["android_hardware_audio_config_defaults"],
}
