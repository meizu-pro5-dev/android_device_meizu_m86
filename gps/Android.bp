cc_library_shared {
    name: "libm86gps_shim",
    compile_multilib: "64",
    srcs: ["GpsCompat.cpp"],
    shared_libs: [
        "libsensor",
        "libssl",
        "libutils",
    ],
    ldflags: ["-Wl,--no-as-needed"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
