# Empty root-image mountpoint for the read-only Meizu auxiliary partition.
/mnv       u:object_r:rootfs:s0

/vendor/bin/cbd                 u:object_r:m86_cbd_exec:s0
/vendor/bin/gpsd                u:object_r:m86_gpsd_exec:s0
/vendor/bin/mcDriverDaemon      u:object_r:m86_mobicore_exec:s0
/vendor/bin/m86_usb_serial      u:object_r:m86_usb_serial_exec:s0

# Generic GSI init requires an executable domain transition even in permissive
# mode. These HIDL executable names are not covered by Android 13's defaults.
/(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@2\.0-service\.samsung  u:object_r:hal_thermal_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.4-service\.clearkey     u:object_r:hal_drm_default_exec:s0

# m86 Bluetooth owns one 32-bit service and the controller UART. This is a
# legacy-ABI device with a separate vendor filesystem; cover both canonical
# and compatibility spellings as the platform Bluetooth service rule does.
/(vendor|system/vendor)/bin/hw/android\.hardware\.bluetooth@1\.0-service\.m86  u:object_r:hal_bluetooth_default_exec:s0
/dev/ttySAC4                                                                   u:object_r:hci_attach_dev:s0

# Label the Mali render node with the platform GPU type instead of device:s0.
/dev/mali0                                                                     u:object_r:gpu_device:s0

# Device AIDL PowerHAL. Keep the standard PowerHAL domain while exposing the
# modern interface required by SurfaceFlinger expensive-rendering hints.
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.m86             u:object_r:hal_power_default_exec:s0

# The dedicated 32-bit provider must enter the standard camera HAL domain.
# Without the exec type, init treats the binary as vendor_file and refuses the
# transition once enforcing is restored.
/(vendor|system/vendor)/bin/hw/android\.hardware\.camera\.provider@2\.4-service\.m86  u:object_r:hal_camera_default_exec:s0

# Android 13's generic audio service mixes libbinder and libbinder_ndk pools,
# so m86 owns a HIDL-only binary. Keep the standard audio HAL domain despite
# the device suffix on its executable name.
/(vendor|system/vendor)/bin/hw/android\.hardware\.audio\.service\.m86  u:object_r:hal_audio_default_exec:s0

# The NXP Smart-PA control bus is private to the primary audio HAL.
/dev/i2c-7                                                                     u:object_r:m86_audio_i2c_device:s0

# The framework NFC application owns its core data path. The NXP HAL persists
# its state below /data/vendor, which must use a vendor data type under Treble.
# Keep secure-element /dev/p61 handling out of the reader/HCE experiment.
/data/nfc(/.*)?                                                               u:object_r:nfc_data_file:s0
/data/vendor/nfc(/.*)?                                                        u:object_r:m86_nfc_vendor_data_file:s0
/data/vendor/gatekeeper(/.*)?                                                 u:object_r:m86_gatekeeper_vendor_data_file:s0

# The m86 Gatekeeper wrapper retains the platform Gatekeeper HAL domain while
# using a unique output path, so the generic and device services cannot both
# own the same installed file.
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.m86  u:object_r:hal_gatekeeper_default_exec:s0
